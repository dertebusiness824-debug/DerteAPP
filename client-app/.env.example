# ---------------------------------------------------------------------------
# DerteApp Marketplace (PWA de clientes) — configuración de entorno
#
# Esta app NO necesita su propio .env si el repositorio raíz ya tiene los
# valores de Supabase: `vite.config.ts` lee tambien `../.env` y `../.env.local`
# y acepta los nombres que ya usa derteapp:
#
#   NEXT_PUBLIC_SUPABASE_URL / SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY
#
# Solo se exponen al navegador la URL y la clave anon/publishable.
# SUPABASE_SERVICE_ROLE_KEY nunca se incluye en el bundle.
# ---------------------------------------------------------------------------

# --- Supabase (opcional aquí si ya está en el .env de la raíz) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend derteapp (opcional) ---
# Si se define, la PWA puede pedir la config pública de Supabase en caliente a
# GET {VITE_DERTEAPP_API_URL}/api/public/supabase, sin recompilar el bundle.
# Vacío = mismo origen ("/api/public/supabase").
VITE_DERTEAPP_API_URL=

# --- Modo de datos ---
# auto     : usa Supabase si hay credenciales; si no, cae a modo demo (por defecto)
# supabase : exige Supabase y muestra error si falta configuración
# demo     : fuerza el catálogo de demostración local (sin red)
VITE_MARKETPLACE_MODE=auto

# --- Presentación ---
VITE_MARKETPLACE_APP_NAME=DerteApp Talleres
# Ciudad preseleccionada en el selector de ubicación.
VITE_MARKETPLACE_DEFAULT_CITY=Madrid
# Teléfono de la central de urgencias que se muestra como plan B al usuario.
VITE_MARKETPLACE_URGENT_PHONE=+34605686509
