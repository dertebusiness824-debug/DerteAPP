# ---------------------------------------------------------------------------
# DerteApp environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
PORT=3000
# Public origin of the API/PWA. Used to build customer chat links and embed URLs.
APP_URL=http://localhost:3000
APP_NAME=DerteApp

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://derte:derte@127.0.0.1:5432/derteapp
# Set to "require" when the provider needs TLS (most managed Postgres hosts do).
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=30d
# Comma-separated list of extra origins allowed to call the authenticated API.
CORS_ORIGINS=
# Set to true to switch off the in-process rate limiter (local testing only).
RATE_LIMIT_DISABLED=false

# --- Registration / OTP ---
# When true, /api/auth/otp/request returns the code in the response body
# (development only, so you can test without an SMS provider).
OTP_DEBUG=true
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# Only these phone prefixes may register. Empty = allow all.
ALLOWED_PHONE_PREFIXES=
# Open self-service registration. When false only a Super Admin can create shops.
ALLOW_SELF_REGISTRATION=true

# --- Bootstrap Super Admin (created/updated by `npm run seed`) ---
# Super Admin and shop owners sign in with email + password (Google account).
# Optional: GOOGLE_CLIENT_ID enables the «Continuar con Google» button.
# SUPER_ADMIN_PHONE is still required: shop owners see it in support chat.
SUPER_ADMIN_EMAIL=dertebusiness824@gmail.con
SUPER_ADMIN_PHONE=+34600000000
# Local default used by seed when set (e.g. Marron1*). Do not commit real prod secrets.
SUPER_ADMIN_PASSWORD=Marron1*
SUPER_ADMIN_NAME=Super Admin

# Google Identity Services (web Client ID). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# --- Defaults for new shops ---
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_SLOT_MINUTES=60
DEFAULT_CAPACITY=2

# --- Zadarma telephony (https://my.zadarma.com/api/) ---
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_API_URL=https://api.zadarma.com
# Default SIP / PBX internal number used to place callback calls.
ZADARMA_DEFAULT_SIP=
# Set to false to skip HMAC verification of incoming Zadarma webhooks (dev only).
ZADARMA_VERIFY_WEBHOOKS=true

# --- Retell AI voice receptionist (https://dashboard.retellai.com) ---
# Point your Retell agent's webhook at:  <APP_URL>/api/webhooks/retell
# Retell signs webhooks with the API key itself, so this is required to accept
# them. Use an API key that has the webhook badge in the Retell dashboard.
RETELL_API_KEY=
# Only needed if you sign webhooks with a separate key.
RETELL_WEBHOOK_SECRET=
# Set to false to accept unsigned webhooks (local development only).
RETELL_VERIFY_WEBHOOKS=true
# Single-shop installs can name the tenant here instead of configuring routing.
RETELL_DEFAULT_SHOP_ID=
