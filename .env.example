# ---------------------------------------------------------------------------
# DerteApp environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
PORT=3000
# Public origin of the API/PWA. Used to build customer chat links and embed URLs.
APP_URL=http://localhost:3000
APP_NAME=DerteApp

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://derte:derte@127.0.0.1:5432/derteapp
# Optional direct (non-pooled) URL for migrations. Falls back to DATABASE_URL.
# On Supabase, use the "direct" connection string here and the pooler in DATABASE_URL.
DIRECT_URL=
# Set to "require" when the provider needs TLS (most managed Postgres hosts do).
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=30d
# Comma-separated list of extra origins allowed to call the authenticated API.
CORS_ORIGINS=
# Set to true to switch off the in-process rate limiter (local testing only).
RATE_LIMIT_DISABLED=false

# --- Registration / OTP ---
# When true, /api/auth/otp/request returns the code in the response body
# (development only, so you can test without an SMS provider).
OTP_DEBUG=true
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# Only these phone prefixes may register. Empty = allow all.
ALLOWED_PHONE_PREFIXES=
# Open self-service registration. When false only a Super Admin can create shops.
ALLOW_SELF_REGISTRATION=true

# --- Bootstrap Super Admin (created/updated by `npm run seed`) ---
# Super Admin and shop owners sign in with email + password (Google account).
# Optional: GOOGLE_CLIENT_ID enables the «Continuar con Google» button.
# SUPER_ADMIN_PHONE is still required: shop owners see it in support chat.
SUPER_ADMIN_EMAIL=dertebusiness824@gmail.com
SUPER_ADMIN_PHONE=+34605686509
# Local default used by seed when set (e.g. Marron1*). Do not commit real prod secrets.
SUPER_ADMIN_PASSWORD=Marron1*
SUPER_ADMIN_NAME=Super Admin

# Google Identity Services (web Client ID). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Shared OAuth client secret (also used by Calendar if GOOGLE_CALENDAR_CLIENT_SECRET is empty).
GOOGLE_CLIENT_SECRET=

# --- Google Calendar sync (bidirectional) ---
# OAuth2 web client (Calendar API). Redirect URI must be:
#   {APP_URL}/api/shops/google-calendar/callback
# Push notifications (events.watch) post to:
#   {APP_URL}/api/shops/google-calendar/webhook
# APP_URL must be public HTTPS in production for watches to work.
# You may reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional override; defaults to APP_URL + /api/shops/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Optional service-account fallback: shops share their calendar with this email
# and enter the Calendar ID under Settings → Datos del taller.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with \n for newlines, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Defaults for new shops ---
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_SLOT_MINUTES=60
DEFAULT_CAPACITY=2

# --- Zadarma telephony (https://my.zadarma.com/api/) ---
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_API_URL=https://api.zadarma.com
# Default SIP / PBX internal number used to place callback calls.
ZADARMA_DEFAULT_SIP=
# Set to false to skip HMAC verification of incoming Zadarma webhooks (dev only).
ZADARMA_VERIFY_WEBHOOKS=true

# --- Retell AI voice receptionist (https://dashboard.retellai.com) ---
# Point your Retell agent's webhook at:  <APP_URL>/api/webhooks/retell
# Retell signs webhooks with the API key itself, so this is required to accept
# them. Use an API key that has the webhook badge in the Retell dashboard.
RETELL_API_KEY=
# Only needed if you sign webhooks with a separate key.
RETELL_WEBHOOK_SECRET=
# Set to false to accept unsigned webhooks (local development only).
RETELL_VERIFY_WEBHOOKS=true
# Single-shop installs can name the tenant here instead of configuring routing.
RETELL_DEFAULT_SHOP_ID=

# --- Web Push (VAPID) for iOS/Android PWA urgencia alerts ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https:// origin used as VAPID subject
VAPID_SUBJECT=mailto:dertebusiness824@gmail.com

# --- Cal.com (block slots when accepting Urgencias) ---
# Required on Render (both names accepted; prefer CAL_*):
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
# Aliases also work: CALCOM_API_KEY / CALCOM_EVENT_TYPE_ID
#
# Optional:
# CAL_API_URL=https://api.cal.com
# CAL_API_VERSION=v1          # default v1 (start/end + responses). Use v2 for Bearer API.
# CAL_TIMEZONE=Atlantic/Canary
# CAL_DEFAULT_ATTENDEE_EMAIL=sin-email@derteapp.com

# --- Supabase ---
# Prefer putting real keys in `.env.local` (gitignored). These names match the
# Next.js-style public prefix so the same values work across tooling.
# Public (exposed to the PWA via GET /api/public/supabase — anon/publishable only):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Aliases also accepted by the server: SUPABASE_URL / SUPABASE_ANON_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never send this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
