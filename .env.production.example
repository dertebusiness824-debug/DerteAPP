# Copy to .env.production on the server (never commit the filled file).
# Used by: docker compose --env-file .env.production up -d --build

APP_URL=https://app.tudominio.com
APP_NAME=DerteApp
CADDY_DOMAIN=app.tudominio.com
HOST_PORT=3000

POSTGRES_DB=derteapp
POSTGRES_USER=derte
POSTGRES_PASSWORD=cambia-esta-clave-larga

# App pool (Render / Docker usually set DATABASE_URL directly).
DATABASE_URL=
# Optional non-pooled URL for migrations (Supabase direct connection).
DIRECT_URL=
DATABASE_SSL=require

JWT_SECRET=genera-con-node-e-console.log-require-crypto-randomBytes-48-toString-base64url
JWT_EXPIRES_IN=30d
CORS_ORIGINS=

OTP_DEBUG=false
ALLOW_SELF_REGISTRATION=false

# Bootstrapped automatically on app start (bcrypt). Override as needed.
SUPER_ADMIN_EMAIL=dertebusiness824@gmail.com
SUPER_ADMIN_PHONE=+34605686509
SUPER_ADMIN_PASSWORD=Marron1*
SUPER_ADMIN_NAME=Super Admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

DEFAULT_TIMEZONE=Europe/Madrid

ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_DEFAULT_SIP=
